{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Context Variable Node Schema",
  "description": "Store and retrieve variables in workflow context (for AI conversation history, caching, temporary data)",
  "properties": {
    "input": {
      "type": "object",
      "title": "Input Schema",
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["STORE", "RETRIEVE", "APPEND", "CLEAR", "LIST"],
          "default": "STORE",
          "description": "Variable operation to perform"
        },
        "key": {
          "type": "string",
          "description": "Variable key (e.g., 'conversation_history', 'user_context', 'api_cache')"
        },
        "value": {
          "description": "Value to store or append (for STORE/APPEND operations)"
        },
        "overwrite": {
          "type": "boolean",
          "default": true,
          "description": "Whether to overwrite existing value (STORE operation only)"
        },
        "default_value": {
          "description": "Default value to return if key not found (RETRIEVE operation only)"
        }
      },
      "required": ["operation", "key"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "title": "Output Schema",
      "description": "Variable operation result",
      "properties": {
        "result": {
          "type": "object",
          "description": "Operation result details"
        }
      }
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
